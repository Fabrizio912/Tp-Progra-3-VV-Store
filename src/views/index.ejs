<!-- Incluimos los fragmentos ejs de arriba -->
<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    <main>
        <section id="contenedor-productos">

            <!-- EJS itera directamente el array de productos, sin JS adicional -->
            <% if (listaProductos.length === 0) { %>
                <p class="mensaje error">No hay productos cargados</p>
            <% } %>

            <% listaProductos.forEach(producto => { %>
                <div class="card-producto <%= producto.active ? '' : 'card-inactivo' %>">

                    <img class="card-img" src="<%= producto.image %>" alt="<%= producto.name %>">

                    <h4><%= producto.name %></h4>

                    <p><%= producto.description %></p>

                    <p><%= producto.category === "clothes" ? "Indumentaria" : "Calzado" %> / Id: <%= producto.id %></p>

                    <p><strong>$ <%= Number(producto.price).toLocaleString("es-AR") %></strong></p>  <!-- se muestra el precio del producto en negrita y con formato de moneda argentina -->

                    <% if (!producto.active) { %>
                        <p>(Inactivo)</p>
                    <% } %>
                </div>
            <% }) %>

        </section>
    </main>

<%- include("partials/footer.ejs") %>
